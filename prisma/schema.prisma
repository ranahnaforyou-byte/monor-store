// MONOR STORE — database schema
// PostgreSQL + Prisma. Money is ALWAYS an integer number of centimes (DZD).
// Historical orders are immutable: OrderItem / Order snapshot everything.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Product {
  id             String        @id @default(cuid())
  slug           String        @unique
  name           String // primary (Arabic) name
  nameFr         String?
  description    String        @db.Text
  descriptionFr  String?       @db.Text
  brand          String
  sku            String?       @unique
  price          Int // centimes DZD
  compareAtPrice Int? // centimes DZD, struck-through "before" price
  sizes          String[] // display / filter facet, e.g. ["40","41","42"]
  colors         String[] // display / filter facet
  stock          Int           @default(0) // cached = sum(sizeStock.quantity)
  lowStockThreshold Int        @default(3)
  featured       Boolean       @default(false)
  newArrival     Boolean       @default(false)
  sale           Boolean       @default(false)
  status         ProductStatus @default(DRAFT)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  images    ProductImage[]
  sizeStock SizeStock[]
  movements InventoryMovement[]
  orderItems OrderItem[]

  @@index([status, featured])
  @@index([status, newArrival])
  @@index([status, sale])
  @@index([categoryId, status])
  @@index([createdAt])
  @@index([brand])
}

model ProductImage {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url         String // CDN / storage base URL for this image
  driveFileId String? // original archived in Google Drive
  storageKey  String? // object key in R2 / local path
  alt         String   @default("")
  position    Int      @default(0)
  width       Int      @default(0)
  height      Int      @default(0)
  blurDataURL String   @default("")
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([productId, position])
}

model SizeStock {
  id        String @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      String
  quantity  Int    @default(0)

  @@unique([productId, size])
  @@index([productId])
}

model Category {
  id             String     @id @default(cuid())
  slug           String     @unique
  name           String
  nameFr         String?
  description    String?
  image          String?
  position       Int        @default(0)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")

  products Product[]

  @@index([parentId, position])
}

// ---------------------------------------------------------------------------
// Orders
// ---------------------------------------------------------------------------

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  SHIPPED
  DELIVERED
  RETURNED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  REFUNDED
  FAILED
}

enum PaymentMethod {
  COD
  BARIDIMOB
}

enum DeliveryMode {
  HOME
  STOP_DESK
}

model Order {
  id        String @id @default(cuid())
  reference String @unique // MNR-26-000123

  status        OrderStatus   @default(PENDING)
  paymentMethod PaymentMethod @default(COD)
  paymentStatus PaymentStatus @default(UNPAID)

  // Money — all centimes DZD, all computed server-side.
  subtotal      Int
  shippingFee   Int @default(0)
  discountTotal Int @default(0)
  total         Int

  // Customer snapshot
  customerName  String
  customerPhone String
  customerEmail String?

  // Address snapshot
  wilayaCode  Int
  wilayaName  String
  communeName String
  addressLine String
  deliveryMode DeliveryMode @default(HOME)
  notes        String?

  // Yalidine
  yalidineParcelId String?
  yalidineTracking String?
  yalidineLabelUrl String?
  yalidineStatus   String?

  // BaridiMob
  baridimobRef String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  confirmedAt DateTime?
  shippedAt   DateTime?
  deliveredAt DateTime?
  cancelledAt DateTime?

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  items           OrderItem[]
  paymentAttempts PaymentAttempt[]
  movements       InventoryMovement[]
  events          OrderEvent[]

  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([customerId])
  @@index([wilayaCode])
  @@index([customerPhone])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId     String?
  product       Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  // Snapshot — survives later product edits.
  nameSnapshot  String
  slugSnapshot  String
  imageSnapshot String?
  unitPrice     Int // centimes
  size          String
  color         String?
  quantity      Int
  lineTotal     Int // centimes

  @@index([orderId])
  @@index([productId])
}

model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      String // STATUS_CHANGE | PAYMENT | SHIPPING | NOTE
  message   String
  createdAt DateTime @default(now())
  createdBy String? // AdminUser id or "system"

  @@index([orderId, createdAt])
}

model Customer {
  id          String   @id @default(cuid())
  phone       String   @unique // primary identity for COD
  name        String
  email       String?
  wilayaCode  Int?
  wilayaName  String?
  communeName String?
  addressLine String?
  ordersCount Int      @default(0)
  totalSpent  Int      @default(0) // centimes
  blocked     Boolean  @default(false)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders Order[]

  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Inventory
// ---------------------------------------------------------------------------

enum InventoryReason {
  SALE
  RESTOCK
  MANUAL_ADJUSTMENT
  RETURN
}

model InventoryMovement {
  id        String          @id @default(cuid())
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      String
  delta     Int // negative for SALE, positive for RESTOCK/RETURN
  reason    InventoryReason
  orderId   String?
  order     Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  note      String?
  createdBy String? // AdminUser id or "system"
  createdAt DateTime        @default(now())

  @@index([productId, createdAt])
  @@index([reason])
}

// ---------------------------------------------------------------------------
// Admin & auth
// ---------------------------------------------------------------------------

enum AdminRole {
  OWNER
  MANAGER
  STAFF
}

model AdminUser {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  passwordHash  String
  role          AdminRole @default(STAFF)
  disabled      Boolean   @default(false)
  lastLoginAt   DateTime?
  failedLogins  Int       @default(0)
  lockedUntil   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  auditLogs AuditLog[]
}

model AuditLog {
  id          String   @id @default(cuid())
  adminUserId String?
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
  action      String
  entity      String
  entityId    String?
  diff        Json?
  ip          String?
  createdAt   DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
}

// ---------------------------------------------------------------------------
// Payments
// ---------------------------------------------------------------------------

model PaymentAttempt {
  id          String        @id @default(cuid())
  orderId     String
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider    PaymentMethod @default(BARIDIMOB)
  amount      Int // centimes
  providerRef String? // customer-submitted transaction reference
  screenshotUrl String?
  status      PaymentStatus @default(PENDING)
  rawPayload  Json?
  reviewedBy  String?
  reviewedAt  DateTime?
  createdAt   DateTime      @default(now())

  @@index([orderId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Shipping reference data (cached from Yalidine)
// ---------------------------------------------------------------------------

model Wilaya {
  code     Int       @id
  name     String
  nameAr   String
  communes Commune[]
  rate     ShippingRate?
}

model Commune {
  id         String @id @default(cuid())
  name       String
  nameAr     String
  wilayaCode Int
  wilaya     Wilaya @relation(fields: [wilayaCode], references: [code], onDelete: Cascade)
  hasStopDesk Boolean @default(false)

  @@unique([wilayaCode, name])
  @@index([wilayaCode])
}

model ShippingRate {
  wilayaCode  Int      @id
  wilaya      Wilaya   @relation(fields: [wilayaCode], references: [code], onDelete: Cascade)
  toHome      Int // centimes
  toStopDesk  Int // centimes
  returnFee   Int      @default(0)
  active      Boolean  @default(true)
  updatedAt   DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Ops
// ---------------------------------------------------------------------------

model WebhookEvent {
  id         String   @id @default(cuid())
  source     String // YALIDINE | BARIDIMOB
  externalId String // idempotency key
  payload    Json
  status     String   @default("received") // received | processed | error
  error      String?
  receivedAt DateTime @default(now())
  processedAt DateTime?

  @@unique([source, externalId])
  @@index([source, status])
}

/// Single-row store configuration. Row id is always "singleton".
model StoreSetting {
  id                   String  @id @default("singleton")
  storeName            String  @default("MONOR STORE")
  contactPhone         String  @default("")
  contactEmail         String  @default("")
  address              String  @default("")
  instagramUrl         String  @default("")
  facebookUrl          String  @default("")
  tiktokUrl            String  @default("")
  announcementBar      String  @default("")
  announcementActive   Boolean @default(false)
  freeShippingThreshold Int?   // centimes; null = disabled
  defaultHomeFee       Int     @default(40000)
  defaultStopDeskFee   Int     @default(25000)
  codEnabled           Boolean @default(true)
  baridimobEnabled     Boolean @default(false)
  baridimobInfo        String  @default("")
  maintenanceMode      Boolean @default(false)
  // Encrypted integration secrets (AES-256-GCM, key = APP_ENCRYPTION_KEY).
  secretsEnc           Json?
  updatedAt            DateTime @updatedAt
}
