# ------------------------------------------------------------------
# MONOR STORE — environment template
# Copy to .env.local for development. NEVER commit real secrets.
# Every variable is validated in src/lib/env.ts at boot.
# ------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
# Postgres connection string. For local dev without Docker, run `npm run db:up`
# (embedded Postgres) which serves this exact URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/monor?schema=public"
# Public origin of the site (no trailing slash). Used for SEO, OG, absolute links.
APP_URL="http://localhost:3000"
# 32+ char random string. Signs admin session JWTs.  openssl rand -base64 48
AUTH_SECRET="dev-only-change-me-please-32-chars-min-xxxxxxxxxxxxx"
# 32-byte base64 key for AES-256-GCM encryption of integration secrets stored
# in the database (StoreSetting).  openssl rand -base64 32
APP_ENCRYPTION_KEY="dev-only-ZmFrZS1rZXktMzItYnl0ZXMtZm9yLWFlcy1nY20tMDE="

# Seed admin login. If SEED_ADMIN_PASSWORD is empty, `npm run db:seed` generates
# a random password and prints it once.
SEED_ADMIN_EMAIL="admin@monor.store"
SEED_ADMIN_PASSWORD=""

# --- Locale ---------------------------------------------------------------
# Launch locale is Arabic (RTL). Set to "1" to expose the FR switcher.
NEXT_PUBLIC_ENABLE_FRENCH="0"
# DEMO / client-review: "1" shows "prices are test data" banners; "0" (or unset) for production.
NEXT_PUBLIC_DEMO_MODE="0"

# --- Web image storage / CDN (Cloudflare R2 — S3 compatible) --------------
# When R2_* are empty the image pipeline falls back to local disk
# (public/uploads) so the app runs before storage is provisioned.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# Public base URL that serves the bucket, e.g. https://cdn.monor.store
R2_PUBLIC_BASE_URL=""
# Mirror of R2_PUBLIC_BASE_URL for next/image remotePatterns (client-safe host only).
NEXT_PUBLIC_IMAGE_BASE_URL=""

# --- Google Drive (cold storage / originals / backups) — server only -----
# base64 of the service-account JSON key file.
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=""
GOOGLE_DRIVE_ROOT_FOLDER_ID=""

# --- Yalidine (shipping + COD) — server only ----------------------------
YALIDINE_API_ID=""
YALIDINE_API_TOKEN=""
YALIDINE_BASE_URL="https://api.yalidine.app/v1"
YALIDINE_WEBHOOK_SECRET=""

# --- BaridiMob (manual verification at launch) -------------------------
BARIDIMOB_ENABLED="0"
# Free text shown to the customer as payment instructions (RIP / account / name).
BARIDIMOB_ACCOUNT_INFO=""
BARIDIMOB_WEBHOOK_SECRET=""

# --- Jobs / ops --------------------------------------------------------
# Bearer secret required by /api/cron/* endpoints.
CRON_SECRET="dev-only-cron-secret-change-me"

# --- Optional observability (never blocks the store if unset) ---------
SENTRY_DSN=""
NEXT_PUBLIC_ANALYTICS_URL=""
