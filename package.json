{
  "name": "monor-store",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint",
    "postinstall": "prisma generate",
    "db:up": "tsx scripts/pg-dev.ts start",
    "db:down": "tsx scripts/pg-dev.ts stop",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset",
    "import:products": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local --tsconfig tsconfig.scripts.json scripts/import-products.ts",
    "sync:drive": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local --tsconfig tsconfig.scripts.json scripts/sync-drive-images.ts",
    "backup:db": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local --tsconfig tsconfig.scripts.json scripts/backup-db.ts",
    "seed:demo": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local --tsconfig tsconfig.scripts.json scripts/seed-demo.ts",
    "clear:demo": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local --tsconfig tsconfig.scripts.json scripts/clear-demo.ts",
    "add:admin": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local --tsconfig tsconfig.scripts.json scripts/add-admin.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.0",
    "@prisma/client": "6.19.3",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "aws4fetch": "^1.0.20",
    "clsx": "^2.1.1",
    "google-auth-library": "^11.0.2",
    "jose": "^6.2.10",
    "next": "16.3.3",
    "prisma": "6.19.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
